                  "agents/agent-detail",
                  "agents/job-detail"
                ]
              },
              {
                "group": "Workflows",
                "pages": [
                  "workflows/workflows",
                  "workflows/workflow-detail",
                  "workflows/workflow-new",
                  "workflows/workflow-edit",
                  "workflows/workflow-run"
                ]
              },
              {
                "group": "Commands",
                "pages": [
                  "commands/commands",
